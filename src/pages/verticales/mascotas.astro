---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import PageHero from "../../components/shared/PageHero.astro";
import MockCard from "../../components/shared/MockCard.astro";
import FeatureGrid from "../../components/shared/FeatureGrid.astro";
import ModuleChips from "../../components/shared/ModuleChips.astro";
import StatsBand from "../../components/shared/StatsBand.astro";
import Cta from "../../components/Cta.astro";
import Footer from "../../components/Footer.astro";

const features = [
	{ icon: "▣", title: "POS especializado", desc: "Vendé alimento, accesorios y equipos vivos desde una sola pantalla." },
	{ icon: "▦", title: "Control de inventario de productos y accesorios", desc: "Existencias actualizadas de cada producto, sin quiebres de stock sorpresa." },
	{ icon: "⚡", title: "Facturación DTE", desc: "Cada venta sale con su documento electrónico sellado al instante." },
	{ icon: "◎", title: "Órdenes de servicio", desc: "Agendá y cobrá baños, cortes o revisiones como un servicio más del sistema." },
	{ icon: "▤", title: "Listas de precios", desc: "Precios por línea de producto o por cliente frecuente." },
	{ icon: "◈", title: "Reportes de ventas", desc: "Mirá qué productos rotan más y ajustá tus compras con datos reales." },
];

const modules = [
	{ name: "Módulos incluidos", apps: ["Punto de Venta", "Inventario", "Facturación electrónica", "Órdenes de servicio", "Contabilidad", "Reportes"] },
];

const whyMetrics = [
	{ count: 10, prefix: "+", label: "años de experiencia" },
	{ count: 4, suffix: "+", label: "empresas en producción" },
	{ count: 100, suffix: "%", label: "DTE con normativa vigente" },
	{ count: 24, suffix: "/7", label: "soporte y monitoreo" },
];
---

<Layout
	title="Mascotas y Acuarios · CodeFactory"
	description="Punto de venta, inventario de productos vivos, órdenes de servicio y facturación DTE para tiendas de mascotas y acuarios en El Salvador."
>
	<Header />
	<PageHero
		theme="light"
		badge="Verticales · Mascotas y acuarios"
		title="Tu tienda de mascotas con inventario vivo <em>bajo control</em>"
		description="Punto de venta, inventario de productos y accesorios, órdenes de servicio y facturación electrónica conectados en un solo sistema. Pensado para tiendas como Acuario Exotic Fantasy."
		ctaPrimary={{ text: "Solicitar demo", href: "/#contacto" }}
		ctaSecondary={{ text: "Ver clientes", href: "/#clientes" }}
	>
		<MockCard
			icon="▣"
			title="POS · Mostrador"
			badgeText="Venta activa"
			badgeTone="live"
			floats={[
				{ icon: "▦", text: "Productos y complementos", style: "top:-16px;left:28px" },
				{ text: "POS con DTE", style: "top:-16px;right:-16px" },
				{ text: "Inventario en tiempo real", style: "bottom:-16px;right:20px" },
			]}
		>
			<div class="pos-lines">
				<div class="pos-line"><span>Alimento premium x2</span><b>$22.00</b></div>
				<div class="pos-line"><span>Acuario 20gal x1</span><b>$45.00</b></div>
				<div class="pos-line"><span>Accesorios x3</span><b>$13.50</b></div>
			</div>
			<div class="pos-total"><span>Total (DTE incluido)</span><b>$80.50</b></div>
			<div class="dte-status">
				<span class="dte-status-dot"></span>
				Documento electrónico emitido
			</div>
		</MockCard>
	</PageHero>

	<FeatureGrid kicker="Características" title="Todo lo que necesita tu tienda" items={features} />

	<ModuleChips kicker="Módulos incluidos" title="Un sistema, todas las áreas de tu tienda" categories={modules} note="Sumamos más módulos según cómo crezca tu operación." />

	<StatsBand kicker="Resultados que respaldan la propuesta" title="Por qué CodeFactory" items={whyMetrics} />

	<Cta />
	<Footer />
</Layout>

<style>
.pos-lines{display:grid;gap:8px;margin-bottom:14px}
.pos-line{display:flex;justify-content:space-between;background:rgba(255,255,255,.05);border:1px solid var(--dark-line);border-radius:8px;padding:10px 12px;font-size:13px}
.pos-line span{color:#c9d6e6}
.pos-line b{font-weight:700}
.pos-total{display:flex;justify-content:space-between;padding:12px 4px;border-top:1px solid var(--dark-line);margin-bottom:16px;font-weight:800;font-size:14px}
.dte-status{display:flex;align-items:center;gap:8px;background:rgba(56,224,176,.1);border:1px solid rgba(56,224,176,.3);border-radius:10px;padding:10px 14px;font-size:12.5px;font-weight:700;color:var(--accent-2)}
.dte-status-dot{width:8px;height:8px;border-radius:50%;background:var(--accent-2);flex-shrink:0}
</style>
