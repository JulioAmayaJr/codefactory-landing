---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import PageHero from "../../components/shared/PageHero.astro";
import MockDashboard from "../../components/shared/MockDashboard.astro";
import FeatureGrid from "../../components/shared/FeatureGrid.astro";
import ModuleChips from "../../components/shared/ModuleChips.astro";
import StatsBand from "../../components/shared/StatsBand.astro";
import Cta from "../../components/Cta.astro";
import Footer from "../../components/Footer.astro";

const metrics = [
	{ icon: "/img/icons/talleres/vehiculos.svg", value: "42", label: "Vehículos en taller", sublabel: "Vehículos activos" },
	{ icon: "/img/icons/talleres/citas.svg", value: "18", label: "Citas hoy", sublabel: "Servicios programados" },
	{ icon: "/img/icons/talleres/reparaciones.svg", value: "11", label: "Reparaciones en proceso", sublabel: "Órdenes abiertas" },
	{ icon: "/img/icons/talleres/tecnicos.svg", value: "8", label: "Técnicos activos", sublabel: "Trabajando" },
];

const featuredOrder = {
	icon: "/img/icons/talleres/vehiculo-activo.svg",
	title: "Yamaha XJ6 · P-123456",
	service: "Cambio de embrague",
	technician: "Carlos Méndez",
	status: "En proceso",
};

const floatChips = [
	{ icon: "/img/icons/talleres/experiencia.svg", text: "+2 años de experiencia", style: "bottom:56px;left:-192px" },
	{ icon: "/img/icons/talleres/certificado.svg", text: "Servicio confiable", style: "bottom:108px;right:-20px" },
];

const features = [
	{ icon: "◎", title: "Órdenes de trabajo kanban", desc: "Cada vehículo avanza por etapas visibles: recepción, diagnóstico, reparación y entrega." },
	{ icon: "▤", title: "Presupuestos y anticipos", desc: "Aprobá el presupuesto con el cliente y cobrá el anticipo antes de empezar." },
	{ icon: "▦", title: "Consumo de repuestos ligado a inventario", desc: "Cada repuesto usado se descuenta del inventario automáticamente." },
	{ icon: "▣", title: "Cobro desde POS", desc: "Cerrá la orden y cobrá sin salir del sistema." },
	{ icon: "⚡", title: "Facturación DTE", desc: "Factura o Crédito Fiscal transmitidos al Ministerio de Hacienda al momento del cobro." },
	{ icon: "◈", title: "Historial por vehículo", desc: "Consultá el historial completo de servicios de cada vehículo que entra a tu taller." },
];

const modules = [
	{ name: "Módulos incluidos", apps: ["Órdenes de Trabajo", "Inventario/Repuestos", "Punto de Venta", "Contabilidad", "Facturación electrónica", "Reportes"] },
];

const whyMetrics = [
	{ count: 10, prefix: "+", label: "años de experiencia" },
	{ count: 4, suffix: "+", label: "empresas en producción" },
	{ count: 100, suffix: "%", label: "DTE con normativa vigente" },
	{ count: 24, suffix: "/7", label: "soporte y monitoreo" },
];
---

<Layout
	title="CodeFactory · Talleres Automotrices"
	description="Órdenes de trabajo por etapas, anticipos, control de repuestos y facturación DTE para talleres automotrices en El Salvador."
>
	<Header />
	<PageHero
		theme="light"
		badge="Talleres automotrices"
		title="Tu taller <em>organizado</em> de la recepción a la entrega"
		description="Órdenes de trabajo por etapas, anticipos, consumo de repuestos y facturación electrónica conectados en un solo sistema. Pensado para talleres."
		ctaPrimary={{ text: "Solicitar demo", href: "/#contacto" }}
		ctaSecondary={{ text: "Ver clientes", href: "/#clientes" }}
	>
		<MockDashboard
			icon="/img/icons/talleres/header.svg"
			titleBold="Taller"
			titleNormal="Live Dashboard"
			badgeText="Operativo"
			metrics={metrics}
			floats={floatChips}
		>
			<div class="td-featured">
				<span class="td-featured-icon">
					<img src={featuredOrder.icon} width="24" height="24" alt="" />
				</span>
				<div class="td-featured-body">
					<b class="td-featured-title">{featuredOrder.title}</b>
					<span class="td-featured-line">{featuredOrder.service}</span>
					<span class="td-featured-line">Técnico: <span class="td-featured-tech">{featuredOrder.technician}</span></span>
				</div>
				<span class="td-badge-fill">{featuredOrder.status}</span>
			</div>
		</MockDashboard>
	</PageHero>

	<FeatureGrid kicker="Características" title="Todo lo que necesita tu taller" items={features} />

	<ModuleChips kicker="Módulos incluidos" title="Un sistema, todas las áreas de tu taller" categories={modules} note="Sumamos más módulos según cómo crezca tu taller." />

	<StatsBand kicker="Resultados que respaldan la propuesta" title="Por qué CodeFactory" items={whyMetrics} />

	<Cta />
	<Footer />
</Layout>

<style>
.td-featured{display:flex;align-items:center;gap:14px;border:1px solid var(--accent);border-radius:16px;padding:16px 18px;background:rgba(0,194,255,.06)}
.td-featured-icon{width:48px;height:48px;border-radius:50%;background:rgba(0,194,255,.15);display:flex;align-items:center;justify-content:center;flex-shrink:0}
.td-featured-icon img{object-fit:contain}
.td-featured-body{flex:1;display:flex;flex-direction:column;gap:3px}
.td-featured-title{font-size:14px;font-weight:800}
.td-featured-line{font-size:12.5px;color:#a9bcd4;line-height:1.5}
.td-featured-tech{color:var(--accent-2);font-weight:700}
.td-badge-fill{background:rgba(56,224,176,.15);color:var(--accent-2);border:1px solid rgba(56,224,176,.35);padding:5px 12px;border-radius:999px;font-size:10.5px;font-weight:800;letter-spacing:.04em;text-transform:uppercase;flex-shrink:0}
</style>
