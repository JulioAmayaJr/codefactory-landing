---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import PageHero from "../../components/shared/PageHero.astro";
import MockCard from "../../components/shared/MockCard.astro";
import FeatureGrid from "../../components/shared/FeatureGrid.astro";
import ModuleChips from "../../components/shared/ModuleChips.astro";
import StatsBand from "../../components/shared/StatsBand.astro";
import Cta from "../../components/Cta.astro";
import Footer from "../../components/Footer.astro";

const features = [
	{ icon: "▣", title: "POS multi-caja", desc: "Varias cajas vendiendo al mismo tiempo, con inventario y caja sincronizados en tiempo real." },
	{ icon: "▦", title: "Control de inventario y compras", desc: "Existencias actualizadas en cada venta y compra, sin conteos manuales." },
	{ icon: "⚡", title: "DTE en el ticket", desc: "Cada venta sale con su documento electrónico ya sellado, sin pasos extra en caja." },
	{ icon: "▤", title: "Listas de precios", desc: "Precios por cliente, por sucursal o por promoción, aplicados automáticamente." },
	{ icon: "◎", title: "Reportes por sucursal", desc: "Ventas, márgenes y existencias comparados entre tus puntos de venta." },
	{ icon: "✚", title: "Cierre de caja", desc: "Arqueo y cierre diario con el detalle de cada método de pago." },
];

const modules = [
	{ name: "Módulos incluidos", apps: ["Punto de Venta", "Inventario", "Contabilidad", "Facturación electrónica", "Compras", "Reportes"] },
];

const whyMetrics = [
	{ count: 10, prefix: "+", label: "años de experiencia" },
	{ count: 4, suffix: "+", label: "empresas en producción" },
	{ count: 100, suffix: "%", label: "DTE con normativa vigente" },
	{ count: 24, suffix: "/7", label: "soporte y monitoreo" },
];
---

<Layout
	title="Retail y Comercios · CodeFactory"
	description="Punto de venta multi-caja, inventario, contabilidad y facturación electrónica DTE conectados para comercios y jugueterías en El Salvador."
>
	<Header />
	<PageHero
		theme="light"
		badge="Verticales · Retail y comercios"
		title="Tu comercio vendiendo con <em>Odoo + DTE</em> en el ticket"
		description="Punto de venta táctil, inventario, contabilidad y facturación electrónica conectados en un solo sistema. Pensado para jugueterías como MundoToys, tiendas especializadas y comercios multi-sucursal."
		ctaPrimary={{ text: "Solicitar demo", href: "/#contacto" }}
		ctaSecondary={{ text: "Ver clientes", href: "/#clientes" }}
	>
		<MockCard
			icon="▦"
			title="POS · Caja 1"
			badgeText="Venta activa"
			badgeTone="live"
			floats={[
				{ icon: "▣", text: "Impresora térmica", style: "top:-16px;left:28px" },
				{ text: "Escáner de código", style: "top:-16px;right:-16px" },
				{ text: "Multi-caja", style: "bottom:-16px;right:30px" },
			]}
		>
			<div class="pos-lines">
				<div class="pos-line"><span>2x Juguete premium</span><b>$18.00</b></div>
				<div class="pos-line"><span>1x Accesorio</span><b>$4.50</b></div>
				<div class="pos-line"><span>3x Bebidas</span><b>$7.50</b></div>
			</div>
			<div class="pos-total"><span>Total (IVA incluido)</span><b>$30.00</b></div>
			<div class="pos-actions">
				<button class="pos-btn">Efectivo</button>
				<button class="pos-btn pos-btn-accent">Tarjeta · DTE</button>
			</div>
		</MockCard>
	</PageHero>

	<FeatureGrid kicker="Características" title="Todo lo que necesita tu comercio" items={features} />

	<ModuleChips kicker="Módulos incluidos" title="Un sistema, todas las áreas de tu comercio" categories={modules} note="Sumamos más módulos según cómo crezca tu comercio." />

	<StatsBand kicker="Resultados que respaldan la propuesta" title="Por qué CodeFactory" items={whyMetrics} />

	<Cta />
	<Footer />
</Layout>

<style>
.pos-lines{display:grid;gap:8px;margin-bottom:14px}
.pos-line{display:flex;justify-content:space-between;background:rgba(255,255,255,.05);border:1px solid var(--dark-line);border-radius:8px;padding:10px 12px;font-size:13px}
.pos-line span{color:#c9d6e6}
.pos-line b{font-weight:700}
.pos-total{display:flex;justify-content:space-between;padding:12px 4px;border-top:1px solid var(--dark-line);margin-bottom:16px;font-weight:800;font-size:14px}
.pos-actions{display:flex;gap:10px}
.pos-btn{flex:1;padding:11px;border-radius:8px;border:1px solid var(--dark-line);background:rgba(255,255,255,.05);color:var(--white);font-weight:700;font-size:12.5px;font-family:inherit;cursor:pointer}
.pos-btn-accent{background:var(--accent);color:var(--navy);border-color:transparent}
</style>
