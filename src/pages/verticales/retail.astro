---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import PageHero from "../../components/shared/PageHero.astro";
import MockDashboard from "../../components/shared/MockDashboard.astro";
import FeatureGrid from "../../components/shared/FeatureGrid.astro";
import ModuleChips from "../../components/shared/ModuleChips.astro";
import StatsBand from "../../components/shared/StatsBand.astro";
import Cta from "../../components/Cta.astro";
import Footer from "../../components/Footer.astro";

const metrics = [
	{ icon: "/img/icons/retail/ventas.svg", value: "342", label: "Ventas del día", sublabel: "Tickets emitidos" },
	{ icon: "/img/icons/retail/dte.svg", value: "296", label: "DTE emitidos hoy", sublabel: "Transmitidos a Hacienda" },
	{ icon: "/img/icons/retail/inventario.svg", value: "3,480", label: "Productos en inventario", sublabel: "Sincronizado en tiempo real" },
	{ icon: "/img/icons/retail/sucursales.svg", value: "4", label: "Sucursales activas", sublabel: "Conectadas al POS central" },
];

const paymentMethods = [
	{ icon: "/img/icons/retail/efectivo.svg", label: "Efectivo", accent: false },
	{ icon: "/img/icons/retail/transferencia.svg", label: "Transferencia", accent: false },
	{ icon: "/img/icons/retail/tarjeta.svg", label: "Tarjeta", accent: true },
];

const floatChips = [
	{ icon: "/img/icons/retail/sucursal.svg", text: '<span class="dash-float-accent">Multi-sucursal</span> en tiempo real', style: "bottom:16px;left:-208px" },
	{ icon: "/img/icons/retail/certificado.svg", text: "DTE certificado", sublabel: "Ministerio de Hacienda", style: "bottom:70px;right:-20px" },
];

const features = [
	{ icon: "▣", title: "POS multi-caja", desc: "Varias cajas vendiendo al mismo tiempo, con inventario y caja sincronizados en tiempo real." },
	{ icon: "▦", title: "Control de inventario y compras", desc: "Existencias actualizadas en cada venta y compra, sin conteos manuales." },
	{ icon: "⚡", title: "DTE en el ticket", desc: "Cada venta sale con su documento electrónico ya sellado, sin pasos extra en caja." },
	{ icon: "▤", title: "Listas de precios", desc: "Precios por cliente, por sucursal o por promoción, aplicados automáticamente." },
	{ icon: "◎", title: "Reportes por sucursal", desc: "Ventas, márgenes y existencias comparados entre tus puntos de venta." },
	{ icon: "✚", title: "Cierre de caja", desc: "Arqueo y cierre diario con el detalle de cada método de pago." },
];

const modules = [
	{ name: "Módulos incluidos", apps: ["Punto de Venta", "Inventario", "Contabilidad", "Facturación electrónica", "Compras", "Reportes"] },
];

const whyMetrics = [
	{ count: 10, prefix: "+", label: "años de experiencia" },
	{ count: 4, suffix: "+", label: "empresas en producción" },
	{ count: 100, suffix: "%", label: "DTE con normativa vigente" },
	{ count: 24, suffix: "/7", label: "soporte y monitoreo" },
];
---

<Layout
	title="CodeFactory · Retail y Comercios"
	description="Punto de venta multi-caja, inventario, contabilidad y facturación electrónica DTE conectados para comercios y jugueterías en El Salvador."
>
	<Header />
	<PageHero
		theme="light"
		badge="Verticales · Retail y comercios"
		title="Tu comercio vendiendo con <em>Odoo + DTE</em> en el ticket"
		description="Punto de venta táctil, inventario, contabilidad y facturación electrónica conectados en un solo sistema. Pensado para jugueterías como MundoToys, tiendas especializadas y comercios multi-sucursal."
		ctaPrimary={{ text: "Solicitar demo", href: "/#contacto" }}
		ctaSecondary={{ text: "Ver clientes", href: "/#clientes" }}
	>
		<MockDashboard
			icon="/img/icons/retail/header.svg"
			titleBold="Retail"
			titleNormal="Live Dashboard"
			badgeText="Operativo"
			metrics={metrics}
			floats={floatChips}
		>
			<div class="pay-row">
				{paymentMethods.map((method) => (
					<button class:list={["pay-btn", method.accent && "pay-btn-accent"]}>
						<img src={method.icon} width="20" height="20" alt="" />
						{method.label}
					</button>
				))}
			</div>
		</MockDashboard>
	</PageHero>

	<FeatureGrid kicker="Características" title="Todo lo que necesita tu comercio" items={features} />

	<ModuleChips kicker="Módulos incluidos" title="Un sistema, todas las áreas de tu comercio" categories={modules} note="Sumamos más módulos según cómo crezca tu comercio." />

	<StatsBand kicker="Resultados que respaldan la propuesta" title="Por qué CodeFactory" items={whyMetrics} />

	<Cta />
	<Footer />
</Layout>

<style>
.pay-row{display:flex;gap:12px}
.pay-btn{flex:1;display:flex;align-items:center;justify-content:center;gap:10px;padding:14px;border-radius:12px;border:1px solid rgba(255,255,255,.08);background:rgba(255,255,255,.04);color:var(--white);font-family:inherit;font-size:15px;font-weight:700;cursor:pointer}
.pay-btn img{object-fit:contain;flex-shrink:0}
.pay-btn-accent{background:var(--accent);color:var(--navy);border-color:transparent}

@media (max-width:900px){
  .pay-row{flex-wrap:wrap}
  .pay-btn{flex:1 1 100%}
}
</style>