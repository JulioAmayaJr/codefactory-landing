---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import PageHero from "../../components/shared/PageHero.astro";
import MockDashboard from "../../components/shared/MockDashboard.astro";
import FeatureGrid from "../../components/shared/FeatureGrid.astro";
import ModuleChips from "../../components/shared/ModuleChips.astro";
import StatsBand from "../../components/shared/StatsBand.astro";
import Cta from "../../components/Cta.astro";
import Footer from "../../components/Footer.astro";

const metrics = [
	{ icon: "/img/icons/ferreteria/ventas.svg", value: "128", label: "Ventas del día", sublabel: "Transacciones realizadas" },
	{ icon: "/img/icons/ferreteria/cotizaciones.svg", value: "32", label: "Cotizaciones hoy", sublabel: "Solicitudes atendidas" },
	{ icon: "/img/icons/ferreteria/inventario.svg", value: "1,256", label: "Productos en inventario", sublabel: "Disponibles" },
	{ icon: "/img/icons/ferreteria/clientes.svg", value: "7", label: "Clientes atendidos", sublabel: "Hoy" },
];

const featuredProduct = {
	icon: "/img/icons/ferreteria/producto.svg",
	title: "Taladro Inalámbrico GSR 18V",
	code: "06019K3000",
	stock: "12 unidades",
	location: "Pasillo 3 · Estante B",
	status: "En stock",
};

const floatChips = [
	{ icon: "/img/icons/ferreteria/calidad.svg", text: "Calidad y confianza", sublabel: "en cada producto", style: "bottom:128px;right:-20px" },
];

const features = [
	{ icon: "▦", title: "Catálogo extenso con códigos de barra", desc: "Miles de productos organizados y listos para escanear en segundos." },
	{ icon: "◈", title: "Unidades de medida múltiples", desc: "Vendé por unidad, caja, quintal o metro sin conversiones manuales." },
	{ icon: "▤", title: "Listas de precios y descuentos por volumen", desc: "Precios diferenciados por cliente y descuentos automáticos por cantidad." },
	{ icon: "⚡", title: "Factura o CCF directo en caja", desc: "Elegí el documento correcto según el cliente, sellado al instante." },
	{ icon: "▣", title: "Control de bodegas", desc: "Existencias por bodega o sucursal, siempre actualizadas." },
	{ icon: "↻", title: "Compras a proveedores", desc: "Órdenes de compra y recepción de mercadería conectadas a tu inventario." },
];

const modules = [
	{ name: "Módulos incluidos", apps: ["Inventario", "Compras", "Punto de Venta", "Contabilidad", "Facturación electrónica", "Listas de precios"] },
];

const whyMetrics = [
	{ count: 10, prefix: "+", label: "años de experiencia" },
	{ count: 4, suffix: "+", label: "empresas en producción" },
	{ count: 100, suffix: "%", label: "DTE con normativa vigente" },
	{ count: 24, suffix: "/7", label: "soporte y monitoreo" },
];
---

<Layout
	title="CodeFactory · Ferreterías y Distribución"
	description="Catálogo extenso con códigos de barra, listas de precios, control de bodegas y Factura o CCF directo en caja para ferreterías en El Salvador."
>
	<Header />
	<PageHero
		theme="light"
		badge="Verticales · Ferreterías y distribución"
		title="Inventario grande, venta de mostrador <em>ágil</em>"
		description="Catálogo extenso, listas de precios, control de bodegas y facturación electrónica conectados en un solo sistema. Pensado para ferreterías como Ferretería SapoteDulce."
		ctaPrimary={{ text: "Solicitar demo", href: "/#contacto" }}
		ctaSecondary={{ text: "Ver clientes", href: "/#clientes" }}
	>
		<MockDashboard
			icon="/img/icons/ferreteria/header.svg"
			titleBold="Ferretería"
			titleNormal="Live Dashboard"
			badgeText="Operativo"
			metrics={metrics}
			floats={floatChips}
		>
			<div class="fer-featured">
				<span class="fer-featured-icon">
					<img src={featuredProduct.icon} width="24" height="24" alt="" />
				</span>
				<div class="fer-featured-body">
					<b class="fer-featured-title">{featuredProduct.title}</b>
					<span class="fer-featured-line">Código: {featuredProduct.code}</span>
					<span class="fer-featured-line">Stock disponible: <span class="fer-featured-highlight">{featuredProduct.stock}</span></span>
					<span class="fer-featured-line">Ubicación: <span class="fer-featured-highlight">{featuredProduct.location}</span></span>
				</div>
				<span class="fer-badge-fill">{featuredProduct.status}</span>
			</div>
		</MockDashboard>
	</PageHero>

	<FeatureGrid kicker="Características" title="Todo lo que necesita tu ferretería" items={features} />

	<ModuleChips kicker="Módulos incluidos" title="Un sistema, todas las áreas de tu negocio" categories={modules} note="Sumamos más módulos según cómo crezca tu operación." />

	<StatsBand kicker="Resultados que respaldan la propuesta" title="Por qué CodeFactory" items={whyMetrics} />

	<Cta />
	<Footer />
</Layout>

<style>
.fer-featured{display:flex;align-items:center;gap:14px;border:1px solid var(--accent);border-radius:16px;padding:16px 18px;background:rgba(0,194,255,.06)}
.fer-featured-icon{width:48px;height:48px;border-radius:50%;background:rgba(0,194,255,.15);display:flex;align-items:center;justify-content:center;flex-shrink:0}
.fer-featured-icon img{object-fit:contain}
.fer-featured-body{flex:1;display:flex;flex-direction:column;gap:3px}
.fer-featured-title{font-size:14px;font-weight:800}
.fer-featured-line{font-size:12.5px;color:#a9bcd4;line-height:1.5}
.fer-featured-highlight{color:var(--accent-2);font-weight:700}
.fer-badge-fill{background:rgba(56,224,176,.15);color:var(--accent-2);border:1px solid rgba(56,224,176,.35);padding:5px 12px;border-radius:999px;font-size:10.5px;font-weight:800;letter-spacing:.04em;text-transform:uppercase;flex-shrink:0}
</style>