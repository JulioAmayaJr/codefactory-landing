---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import PageHero from "../../components/shared/PageHero.astro";
import MockCard from "../../components/shared/MockCard.astro";
import FeatureGrid from "../../components/shared/FeatureGrid.astro";
import ModuleChips from "../../components/shared/ModuleChips.astro";
import StatsBand from "../../components/shared/StatsBand.astro";
import Cta from "../../components/Cta.astro";
import Footer from "../../components/Footer.astro";

const features = [
	{ icon: "▦", title: "Catálogo extenso con códigos de barra", desc: "Miles de productos organizados y listos para escanear en segundos." },
	{ icon: "◈", title: "Unidades de medida múltiples", desc: "Vendé por unidad, caja, quintal o metro sin conversiones manuales." },
	{ icon: "▤", title: "Listas de precios y descuentos por volumen", desc: "Precios diferenciados por cliente y descuentos automáticos por cantidad." },
	{ icon: "⚡", title: "Factura o CCF directo en caja", desc: "Elegí el documento correcto según el cliente, sellado al instante." },
	{ icon: "▣", title: "Control de bodegas", desc: "Existencias por bodega o sucursal, siempre actualizadas." },
	{ icon: "↻", title: "Compras a proveedores", desc: "Órdenes de compra y recepción de mercadería conectadas a tu inventario." },
];

const modules = [
	{ name: "Módulos incluidos", apps: ["Inventario", "Compras", "Punto de Venta", "Contabilidad", "Facturación electrónica", "Listas de precios"] },
];

const whyMetrics = [
	{ count: 10, prefix: "+", label: "años de experiencia" },
	{ count: 4, suffix: "+", label: "empresas en producción" },
	{ count: 100, suffix: "%", label: "DTE con normativa vigente" },
	{ count: 24, suffix: "/7", label: "soporte y monitoreo" },
];
---

<Layout
	title="Ferreterías y Distribución · CodeFactory"
	description="Catálogo extenso con códigos de barra, listas de precios, control de bodegas y Factura o CCF directo en caja para ferreterías en El Salvador."
>
	<Header />
	<PageHero
		theme="light"
		badge="Verticales · Ferreterías y distribución"
		title="Inventario grande, venta de mostrador <em>ágil</em>"
		description="Catálogo extenso, listas de precios, control de bodegas y facturación electrónica conectados en un solo sistema. Pensado para ferreterías como Ferretería SapoteDulce."
		ctaPrimary={{ text: "Solicitar demo", href: "/#contacto" }}
		ctaSecondary={{ text: "Ver clientes", href: "/#clientes" }}
	>
		<MockCard
			icon="▦"
			title="Venta de mostrador"
			badgeText="Venta activa"
			badgeTone="live"
			floats={[
				{ icon: "▤", text: "Códigos de barra", style: "top:-16px;left:28px" },
				{ text: "Listas de precios", style: "top:-16px;right:-16px" },
				{ text: "Crédito fiscal al instante", style: "bottom:-16px;right:20px" },
			]}
		>
			<div class="scan-row">
				<span class="scan-icon">▤</span>
				<span>Escaneando código...</span>
			</div>
			<div class="pos-lines">
				<div class="pos-line"><span>Cemento gris x10</span><b>$65.00</b></div>
				<div class="pos-line"><span>Clavos 2" x5</span><b>$3.75</b></div>
				<div class="pos-line"><span>Pintura blanca x2</span><b>$28.00</b></div>
			</div>
			<div class="pos-total"><span>Total</span><b>$96.75</b></div>
			<button class="pos-btn pos-btn-accent pos-btn-full">Factura o CCF</button>
		</MockCard>
	</PageHero>

	<FeatureGrid kicker="Características" title="Todo lo que necesita tu ferretería" items={features} />

	<ModuleChips kicker="Módulos incluidos" title="Un sistema, todas las áreas de tu negocio" categories={modules} note="Sumamos más módulos según cómo crezca tu operación." />

	<StatsBand kicker="Resultados que respaldan la propuesta" title="Por qué CodeFactory" items={whyMetrics} />

	<Cta />
	<Footer />
</Layout>

<style>
.scan-row{display:flex;align-items:center;gap:8px;background:rgba(255,255,255,.05);border:1px dashed var(--dark-line);border-radius:8px;padding:10px 12px;margin-bottom:14px;font-size:12px;color:#a9bcd4}
.scan-icon{width:20px;height:20px;border-radius:6px;background:rgba(0,194,255,.15);color:var(--accent);display:flex;align-items:center;justify-content:center;font-size:11px;flex-shrink:0}
.pos-lines{display:grid;gap:8px;margin-bottom:14px}
.pos-line{display:flex;justify-content:space-between;background:rgba(255,255,255,.05);border:1px solid var(--dark-line);border-radius:8px;padding:10px 12px;font-size:13px}
.pos-line span{color:#c9d6e6}
.pos-line b{font-weight:700}
.pos-total{display:flex;justify-content:space-between;padding:12px 4px;border-top:1px solid var(--dark-line);margin-bottom:16px;font-weight:800;font-size:14px}
.pos-btn-full{width:100%;padding:11px;border-radius:8px;border:none;background:var(--accent);color:var(--navy);font-weight:700;font-size:12.5px;font-family:inherit;cursor:pointer}
</style>
