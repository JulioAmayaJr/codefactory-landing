---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import PageHero from "../../components/shared/PageHero.astro";
import MockCard from "../../components/shared/MockCard.astro";
import FeatureGrid from "../../components/shared/FeatureGrid.astro";
import StatsBand from "../../components/shared/StatsBand.astro";
import Cta from "../../components/Cta.astro";
import Footer from "../../components/Footer.astro";

const introStats = [
	{ count: 10, prefix: "+", label: "años de experiencia" },
	{ count: 4, suffix: "+", label: "empresas en producción" },
	{ count: 100, suffix: "%", label: "DTE con normativa vigente" },
	{ count: 24, suffix: "/7", label: "soporte y monitoreo" },
];

const features = [
	{ icon: "▣", title: "Servidores administrados", desc: "Infraestructura dedicada, sin que tengás que preocuparte por administrarla." },
	{ icon: "▤", title: "Respaldos automáticos verificados", desc: "Copias de seguridad diarias, probadas — no solo generadas." },
	{ icon: "✚", title: "Certificados SSL", desc: "Conexión cifrada siempre activa, renovada automáticamente." },
	{ icon: "◎", title: "Monitoreo continuo", desc: "Vigilamos tu sistema 24/7 y actuamos antes de que el problema te alcance." },
	{ icon: "▲", title: "Actualizaciones de seguridad", desc: "Parches y mejoras aplicados sin que tengás que detener tu operación." },
	{ icon: "☎", title: "Soporte directo", desc: "Atención directa en español cuando algo urge, no un ticket perdido." },
];

const whyMetrics = [
	{ count: 10, prefix: "+", label: "años de experiencia" },
	{ count: 4, suffix: "+", label: "empresas en producción" },
	{ count: 100, suffix: "%", label: "DTE con normativa vigente" },
	{ count: 24, suffix: "/7", label: "soporte y monitoreo" },
];
---

<Layout
	title="Soporte y Hosting Odoo · CodeFactory"
	description="Servidores administrados, respaldos verificados, SSL y monitoreo continuo para que tu Odoo opere sin interrupciones."
>
	<Header />
	<PageHero
		theme="dark"
		badge="Soluciones · Hosting"
		title="Tu Odoo operando <em>sin interrupciones</em>"
		description="Servidores administrados, respaldos verificados, certificados SSL y monitoreo continuo. Tu sistema como infraestructura crítica, no como un servidor más."
		ctaPrimary={{ text: "Hablemos de tu hosting", href: "/#contacto" }}
		ctaSecondary={{ text: "Ver clientes", href: "/#clientes" }}
	>
		<MockCard
			icon="▣"
			title="monitor.codefactory"
			badgeText="Operativo"
			badgeTone="live"
			floats={[
				{ icon: "◎", text: "Monitoreo 24/7", style: "top:-18px;right:-24px" },
				{ icon: "▤", text: "Respaldos diarios", style: "bottom:-18px;left:-20px" },
			]}
		>
			<div class="mon-grid">
				<div class="mon-stat"><b>99.9%</b><span>Uptime</span></div>
				<div class="mon-stat"><b>✓</b><span>Respaldos verificados</span></div>
				<div class="mon-stat"><b>✓</b><span>SSL activo</span></div>
			</div>
			<div class="mon-server">
				<span class="mon-dot"></span>
				<span class="mon-server-name">srv-odoo-01</span>
				<span class="mon-server-status">OPERATIVO</span>
			</div>
		</MockCard>
	</PageHero>

	<section class="section">
		<div class="wrap">
			<span class="kicker dark">Hosting administrado</span>
			<h2>Tu infraestructura, nuestra responsabilidad</h2>
			<p class="sub">No tercerizamos tu hosting a un panel genérico. Administramos tus servidores como infraestructura crítica: monitoreados, respaldados y actualizados todos los días.</p>
			<p class="sub">Si algo falla, lo vemos antes que vos — y lo resolvemos sin que tengás que llamar primero.</p>
			<div class="intro-grid">
				{introStats.map((stat) => (
					<div class="intro-stat reveal">
						<b data-count={stat.count} data-prefix={stat.prefix} data-suffix={stat.suffix}>0</b>
						<span>{stat.label}</span>
					</div>
				))}
			</div>
		</div>
	</section>

	<FeatureGrid kicker="Lo que hacemos" title="Características del servicio" items={features} gray />

	<StatsBand kicker="Lo que nos respalda" title="Por qué CodeFactory" items={whyMetrics} />

	<Cta />
	<Footer />
</Layout>

<style>
.mon-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-bottom:16px}
.mon-stat{background:rgba(255,255,255,.05);border:1px solid var(--dark-line);border-radius:10px;padding:14px 10px;text-align:center}
.mon-stat b{display:block;font-size:18px;font-weight:800;color:var(--accent-2);margin-bottom:4px}
.mon-stat span{font-size:11px;color:#a9bcd4}
.mon-server{display:flex;align-items:center;gap:10px;background:rgba(255,255,255,.05);border:1px solid var(--dark-line);border-radius:10px;padding:12px 16px}
.mon-dot{width:8px;height:8px;border-radius:50%;background:var(--accent-2);box-shadow:0 0 0 4px rgba(56,224,176,.2);flex-shrink:0}
.mon-server-name{font-family:monospace;font-size:13px;flex:1}
.mon-server-status{font-size:11px;font-weight:800;color:var(--accent-2);letter-spacing:.04em}

.intro-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:20px;margin-top:32px}
.intro-stat{background:var(--white);border:1px solid var(--gray-line);border-radius:var(--radius);padding:24px 20px;text-align:center;transition:all .22s ease}
.intro-stat:hover{transform:translateY(-4px);box-shadow:0 22px 54px rgba(1,30,65,.10)}
.intro-stat b{display:block;font-size:clamp(22px,2.4vw,28px);font-weight:900;color:#0084b8}
.intro-stat span{font-size:13px;color:var(--gray-text);font-weight:500}

@media (max-width:900px){
  .intro-grid{grid-template-columns:repeat(2,1fr)}
}
@media (max-width:600px){
  .intro-grid{grid-template-columns:1fr}
}
</style>
