---
const odooServices = [
	{ icon: "⚙", title: "Implementación end-to-end", desc: "Diagnóstico, levantamiento de procesos, parametrización y go-live." },
	{ icon: "◎", title: "Capacitación y adopción", desc: "Entrenamiento funcional por rol para tu equipo." },
	{ icon: "▣", title: "Hosting administrado", desc: "Servidores administrados con respaldos verificados, SSL y monitoreo continuo." },
	{ icon: "◆", title: "Desarrollo a medida", desc: "Módulos custom, integraciones API, conectores DTE con Hacienda." },
	{ icon: "☎", title: "Soporte continuo", desc: "Atención directa en español, incidentes y nuevos requerimientos." },
	{ icon: "▲", title: "Migraciones Odoo", desc: "Upgrade entre versiones o desde otros sistemas sin perder historial." },
];
---

<section class="section odoo-services">
	<div class="wrap">
		<span class="kicker dark">Lo que hacemos</span>
		<h2>Nuestros servicios Odoo</h2>
		<div class="grid">
			{odooServices.map((svc) => (
				<div class="odoo-svc reveal">
					<div class="odoo-svc-icon">{svc.icon}</div>
					<h3>{svc.title}</h3>
					<p>{svc.desc}</p>
				</div>
			))}
		</div>
	</div>
</section>

<style>
.odoo-services{background:var(--gray-bg)}
.odoo-services .grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-top:56px}
.odoo-svc{background:var(--white);border:1px solid var(--gray-line);border-radius:var(--radius);padding:30px 26px;transition:all .22s ease}
.odoo-svc:hover{transform:translateY(-6px);box-shadow:0 22px 54px rgba(1,30,65,.12);border-color:transparent}
.odoo-svc-icon{width:46px;height:46px;border-radius:12px;background:rgba(0,194,255,.1);color:#0084b8;display:flex;align-items:center;justify-content:center;font-size:21px;margin-bottom:18px;font-weight:700}
.odoo-svc h3{font-size:17.5px;font-weight:800;margin-bottom:9px}
.odoo-svc p{font-size:14px;color:var(--gray-text)}

@media (max-width:900px){
  .odoo-services .grid{grid-template-columns:repeat(2,1fr)}
}
@media (max-width:600px){
  .odoo-services .grid{grid-template-columns:1fr}
}
</style>
