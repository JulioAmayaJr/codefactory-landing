---
const serviceItems = [
	{ icon: "/img/icons/landing/implementacion.svg", title: "Implementación de Odoo ERP", subtitle: "Consultoría, desarrollo y soporte", href: "/soluciones/odoo" },
	{ icon: "/img/icons/landing/codigo.svg", title: "Desarrollos y Automatizaciones", subtitle: "Software a medida e integraciones", href: "/soluciones/desarrollo" },
	{ icon: "/img/icons/landing/nube.svg", title: "Soporte y Hosting Odoo", subtitle: "Continuidad operativa y monitoreo", href: "/soluciones/hosting" },
	{ icon: "/img/icons/landing/migracion.svg", title: "Migraciones Odoo", subtitle: "Upgrade y migración sin perder historial", href: "/soluciones/migraciones" },
	{ icon: "/img/icons/landing/documentos.svg", title: "Facturación electrónica", subtitle: "DTE, FEL e integraciones por API", href: "/soluciones/facturacion-dte" },
];

const solutionItems = [
	{ icon: "/img/icons/landing/retail.svg", title: "Retail y POS", subtitle: "Comercios multi-sucursal", href: "/verticales/retail" },
	{ icon: "/img/icons/landing/taller.svg", title: "Talleres Automotrices", subtitle: "Órdenes de trabajo y POS de taller", href: "/verticales/talleres" },
	{ icon: "/img/icons/landing/ferreteria.svg", title: "Ferreterías y Distribución", subtitle: "Inventario grande y crédito fiscal", href: "/verticales/ferreterias" },
	{ icon: "/img/icons/landing/acuario.svg", title: "Mascotas y Acuarios", subtitle: "POS e inventario de productos vivos", href: "/verticales/mascotas" },
];

const companyLinks = [
	{ label: "Clientes", href: "/#clientes" },
	{ label: "Industrias", href: "/#verticales" },
	{ label: "Contacto", href: "/#contacto" },
];
---

<header>
	<div class="wrap nav">
		<a href="/" class="brand">
			<img src="/img/logo-codefactory.jpg" alt="CodeFactory" />
			CodeFactory
		</a>
		<nav class="nav-links" id="navLinks">
			<div class="nav-item nav-item-mega">
				<button type="button" class="drop-trigger" aria-haspopup="true" aria-expanded="false">
					Soluciones
					<svg class="caret" width="10" height="6" viewBox="0 0 10 6" fill="none" xmlns="http://www.w3.org/2000/svg">
						<path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
					</svg>
				</button>
				<div class="panel mega">
					<div class="wrap mega-grid">
						<div class="mega-col">
							<span class="mega-label">Servicios</span>
							{serviceItems.map((item) => (
								<a href={item.href} class="mega-item">
									<span class="mega-icon">
										{item.icon.startsWith("/")
											? <span class="icon-mask" style={`--icon:url(${item.icon})`}></span>
											: item.icon}
									</span>
									<span>
										<b>{item.title}</b>
										<small>{item.subtitle}</small>
									</span>
								</a>
							))}
						</div>
						<div class="mega-col">
							<span class="mega-label">Soluciones</span>
							{solutionItems.map((item) => (
								<a href={item.href} class="mega-item">
									<span class="mega-icon">
										{item.icon.startsWith("/")
											? <span class="icon-mask" style={`--icon:url(${item.icon})`}></span>
											: item.icon}
									</span>
									<span>
										<b>{item.title}</b>
										<small>{item.subtitle}</small>
									</span>
								</a>
							))}
						</div>
						<div class="mega-feature">
							<span class="kicker">Producto destacado</span>
							<h4>Facturador DTE está disponible</h4>
							<p>Emisión, firma y sello automático ante el Ministerio de Hacienda. Intégralo a tu sistema o punto de venta sin infraestructura propia.</p>
							<a href="/soluciones/facturacion-dte">Ver facturador →</a>
						</div>
					</div>
				</div>
			</div>
			<div class="nav-item">
				<button type="button" class="drop-trigger" aria-haspopup="true" aria-expanded="false">
					Empresa
					<svg class="caret" width="10" height="6" viewBox="0 0 10 6" fill="none" xmlns="http://www.w3.org/2000/svg">
						<path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
					</svg>
				</button>
				<div class="panel drop">
					{companyLinks.map((link) => <a href={link.href}>{link.label}</a>)}
				</div>
			</div>
			<a href="/#contacto" class="nav-direct">Citas</a>
		</nav>
		<div class="nav-right">
			<a href="tel:+503 7875-4199" class="nav-phone">
				<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" />
				</svg>
				+503 7875-4199
			</a>
			<div class="socials">
				<a href="https://www.facebook.com/profile.php?id=61575564206638" target="_blank" rel="noopener noreferrer" aria-label="Facebook">
					<svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor"><path d="M22 12a10 10 0 1 0-11.5 9.95v-7.04H7.9V12h2.6V9.8c0-2.57 1.53-4 3.87-4 1.12 0 2.3.2 2.3.2v2.5h-1.3c-1.28 0-1.68.8-1.68 1.62V12h2.86l-.46 2.91h-2.4v7.04A10 10 0 0 0 22 12z" /></svg>
				</a>
				<a href="https://www.instagram.com/codefactorysv" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
					<svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5" /><circle cx="12" cy="12" r="4.5" /><circle cx="17.5" cy="6.5" r="1.1" fill="currentColor" stroke="none" /></svg>
				</a>
				<a href="#" aria-label="LinkedIn">
					<svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor"><path d="M4.98 3.5C4.98 4.88 3.86 6 2.48 6S0 4.88 0 3.5 1.12 1 2.48 1s2.5 1.12 2.5 2.5zM.5 8.5h4V23h-4V8.5zM8.5 8.5h3.83v1.98h.05c.53-1 1.85-2.05 3.8-2.05 4.07 0 4.82 2.68 4.82 6.17V23h-4v-6.62c0-1.58-.03-3.6-2.2-3.6-2.2 0-2.54 1.72-2.54 3.5V23h-4V8.5z" /></svg>
				</a>
			</div>
			<a href="/#contacto" class="btn btn-accent">Contáctenos</a>
			<button class="nav-toggle" id="navToggle" aria-label="Abrir menú">☰</button>
		</div>
	</div>
</header>

<style>
header{position:sticky;top:0;z-index:100;background:var(--white);border-bottom:1px solid var(--gray-line)}
.nav{display:flex;align-items:center;justify-content:space-between;height:74px;gap:24px}
.brand{display:flex;align-items:center;gap:11px;color:var(--navy);font-weight:800;font-size:20px;letter-spacing:-.02em}
.brand img{height:40px;width:auto}

.nav-links{display:flex;align-items:center;gap:6px;font-size:14.5px;font-weight:600}
.nav-item{position:relative}
.nav-item-mega{position:static}
.drop-trigger{display:flex;align-items:center;gap:6px;background:none;border:none;font:inherit;color:var(--navy);padding:10px 6px;cursor:pointer}
.drop-trigger:hover{color:#0084b8}
.caret{transition:transform .2s ease;flex-shrink:0}
.nav-item.open .caret{transform:rotate(180deg)}
.nav-direct{color:var(--navy);padding:10px 6px}
.nav-direct:hover{color:#0084b8}

.panel{position:absolute;top:100%;left:0;background:var(--white);display:none;z-index:50}
.nav-item.open .panel.mega{display:block}
.nav-item.open .panel.drop{display:grid}
@media (hover:hover) and (min-width:901px){
  .nav-item:hover .panel.mega{display:block}
  .nav-item:hover .panel.drop{display:grid}
  .nav-item:hover .caret{transform:rotate(180deg)}
}
@media (min-width:901px){
  .nav{align-items:stretch}
  .nav-links{align-items:stretch}
  .nav-item{display:flex;align-items:center}
  .nav-direct{display:flex;align-items:center}
}

.panel.mega{right:0;width:100%;border-top:1px solid var(--gray-line);box-shadow:0 24px 40px rgba(1,30,65,.12)}
.panel.drop{border:1px solid var(--gray-line);border-radius:12px;box-shadow:0 20px 46px rgba(1,30,65,.14);padding:22px;min-width:200px;gap:4px}

.mega-grid{display:grid;grid-template-columns:1.2fr 1.2fr 1fr;gap:24px;padding-top:44px;padding-bottom:44px}
.mega-label{display:block;font-size:11.5px;font-weight:800;letter-spacing:.1em;text-transform:uppercase;color:#0084b8;margin-bottom:14px;padding-bottom:8px;border-bottom:1px solid var(--gray-line)}
.mega-item{display:flex;align-items:flex-start;gap:12px;padding:10px;border-radius:10px;color:var(--navy)}
.mega-item:hover{background:var(--gray-bg)}
.mega-icon{width:34px;height:34px;border-radius:9px;background:rgba(0,194,255,.1);color:#0084b8;display:flex;align-items:center;justify-content:center;font-size:16px;flex-shrink:0;transition:background .18s ease,color .18s ease,transform .18s ease}
.icon-mask{width:18px;height:18px;background:currentColor;-webkit-mask:var(--icon) center/contain no-repeat;mask:var(--icon) center/contain no-repeat}
.mega-item:hover .mega-icon{background:var(--accent);color:var(--white);transform:scale(1.18) rotate(-8deg)}
.mega-item b{display:block;font-size:14px;font-weight:700;transition:color .18s ease}
.mega-item:hover b{color:#0084b8}
.mega-item small{display:block;font-size:12.5px;color:var(--gray-text);font-weight:500;margin-top:2px}

.mega-feature{background:var(--navy);color:var(--white);border-radius:12px;padding:22px}
.mega-feature .kicker{color:var(--accent);margin-bottom:12px}
.mega-feature h4{font-size:17px;font-weight:800;margin-bottom:10px}
.mega-feature p{font-size:13px;color:var(--dark-text);margin-bottom:16px}
.mega-feature a{font-size:13px;font-weight:700;color:var(--accent);text-decoration:underline;text-underline-offset:3px}

.nav-right{display:flex;align-items:center;gap:16px}
.nav-phone{display:flex;align-items:center;gap:7px;color:var(--gray-text);font-size:14px;font-weight:600}
.nav-phone:hover{color:#0084b8}
.socials{display:flex;align-items:center;gap:12px;color:var(--gray-text)}
.socials a{color:inherit;display:flex}
.socials a:hover{color:var(--navy)}
.btn-login{background:transparent;color:var(--navy);border:1.5px solid var(--gray-line)}
.btn-login:hover{border-color:var(--navy)}
.nav .btn{padding:11px 22px;font-size:14px}
.nav-toggle{display:none;background:none;border:none;color:var(--navy);font-size:27px;cursor:pointer}

@media (max-width:900px){
  .nav-phone,.socials,.btn-login,.nav .btn-accent{display:none}
  .nav-toggle{display:block}
  .nav-links{display:none}
  .nav-links.open{display:flex;flex-direction:column;align-items:stretch;position:absolute;top:74px;left:0;right:0;background:var(--white);padding:20px 24px;gap:4px;border-bottom:1px solid var(--gray-line);max-height:calc(100vh - 74px);overflow-y:auto}
  .nav-item{width:100%}
  .drop-trigger,.nav-direct{width:100%;justify-content:space-between;padding:14px 4px;border-bottom:1px solid var(--gray-line)}
  .panel.mega,.panel.drop{position:static;box-shadow:none;border:none;padding:0;width:auto;right:auto}
  .mega-grid{grid-template-columns:1fr;gap:20px;padding-top:12px;padding-bottom:12px}
  .mega-feature{display:none}
  .panel.drop{padding:12px 0 12px 12px;min-width:0}
}
</style>