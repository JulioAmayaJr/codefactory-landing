---
interface Metric {
	icon: string;
	value: string;
	label: string;
	sublabel: string;
}

interface FloatChip {
	icon?: string;
	text: string;
	sublabel?: string;
	style: string;
}

interface Props {
	icon: string;
	titleBold: string;
	titleNormal: string;
	badgeText: string;
	graphLabel?: string;
	metrics: Metric[];
	floats?: FloatChip[];
}

const { icon, titleBold, titleNormal, badgeText, graphLabel, metrics, floats = [] } = Astro.props;
---

<div class="dash-card reveal">
	<div class="dash-head">
		<img src={icon} width="28" height="28" alt="" />
		<span class="dash-head-title"><b>{titleBold} · </b>{titleNormal}</span>
		<span class="dash-badge-outline">{badgeText}</span>
	</div>
	{graphLabel && (
		<div class="dash-graph">
			<span class="dash-graph-label">{graphLabel}</span>
			<svg class="dash-graph-svg" viewBox="0 0 400 80" preserveAspectRatio="none">
				<defs>
					<filter id="dash-glow" x="-50%" y="-50%" width="200%" height="200%">
						<feGaussianBlur stdDeviation="4" result="blur" />
						<feMerge>
							<feMergeNode in="blur" />
							<feMergeNode in="SourceGraphic" />
						</feMerge>
					</filter>
				</defs>
				<polyline class="dash-graph-line" points="0,62 35,58 70,60 105,46 140,50 175,36 210,40 245,24 280,29 315,16 350,20 400,8" />
				<circle class="dash-graph-glow" cx="400" cy="8" r="9" />
				<circle class="dash-graph-dot" cx="400" cy="8" r="4" />
			</svg>
		</div>
	)}
	<div class="dash-metrics">
		{metrics.map((metric) => (
			<div class="dash-metric">
				<img class="dash-metric-icon" src={metric.icon} width="44" height="44" alt="" />
				<div class="dash-metric-body">
					<span class="dash-metric-value">{metric.value}</span>
					<span class="dash-metric-label">{metric.label}</span>
					<span class="dash-metric-sub">{metric.sublabel}</span>
				</div>
			</div>
		))}
	</div>
	<slot />
	{floats.map((f) => (
		<div class="dash-float" style={f.style}>
			{f.icon && <img src={f.icon} width="16" height="16" alt="" />}
			{f.sublabel ? (
				<span class="dash-float-stack">
					<b set:html={f.text}></b>
					<small>{f.sublabel}</small>
				</span>
			) : (
				<span set:html={f.text}></span>
			)}
		</div>
	))}
</div>

<style>
.dash-card{position:relative;background:linear-gradient(160deg,var(--navy-2),var(--navy-3));border:1px solid var(--dark-line);border-radius:var(--radius);padding:28px;box-shadow:0 34px 90px rgba(0,0,0,.45);color:var(--white)}

.dash-head{display:flex;align-items:center;gap:12px;margin-bottom:24px;padding-bottom:18px;border-bottom:1px solid var(--dark-line)}
.dash-head img{object-fit:contain;flex-shrink:0}
.dash-head-title{flex:1;font-size:15px;font-weight:400}
.dash-head-title b{font-weight:800}
.dash-badge-outline{border:1px solid var(--accent-2);color:var(--accent-2);background:transparent;padding:5px 12px;border-radius:999px;font-size:10.5px;font-weight:800;letter-spacing:.04em;text-transform:uppercase;flex-shrink:0}

.dash-graph{margin-bottom:24px}
.dash-graph-label{display:block;font-size:12px;color:#a9bcd4;margin-bottom:10px;font-weight:600}
.dash-graph-svg{width:100%;height:70px;display:block}
.dash-graph-line{fill:none;stroke:var(--accent);stroke-width:2.5;stroke-linecap:round;stroke-linejoin:round}
.dash-graph-glow{fill:var(--accent);opacity:.35;filter:url(#dash-glow)}
.dash-graph-dot{fill:var(--accent)}

.dash-metrics{display:grid;grid-template-columns:repeat(2,1fr);gap:14px;margin-bottom:20px}
.dash-metric{display:flex;align-items:flex-start;gap:14px;background:rgba(255,255,255,.04);border:1px solid var(--dark-line);border-radius:14px;padding:18px}
.dash-metric-icon{object-fit:contain;flex-shrink:0}
.dash-metric-body{display:flex;flex-direction:column;gap:3px}
.dash-metric-value{font-size:32px;font-weight:800;line-height:1}
.dash-metric-label{font-size:13px;font-weight:600;color:#c9d6e6}
.dash-metric-sub{font-size:11.5px;color:#7e94b3}

.dash-float{position:absolute;display:inline-flex;align-items:center;gap:7px;background:var(--navy);border:1px solid var(--dark-line);border-radius:12px;padding:10px 14px;font-size:13px;font-weight:700;color:var(--white);box-shadow:0 14px 30px rgba(1,30,65,.35);white-space:nowrap;z-index:2}
.dash-float img{object-fit:contain;flex-shrink:0}
.dash-float-stack{display:flex;flex-direction:column;gap:2px}
.dash-float-stack b{font-size:13px;font-weight:800}
.dash-float-stack small{font-size:10.5px;font-weight:600;color:#a9bcd4}
:global(.dash-float-accent){color:var(--accent)}

@media (max-width:900px){
  .dash-metrics{grid-template-columns:1fr}
  .dash-float{display:none}
}
</style>
