---
interface FeatureItem {
	icon: string;
	title: string;
	desc: string;
}

interface Props {
	kicker: string;
	title: string;
	items: FeatureItem[];
	gray?: boolean;
}

const { kicker, title, items, gray = false } = Astro.props;
---

<section class:list={["section", "fg-section", { "fg-gray": gray }]}>
	<div class="wrap">
		<span class="kicker dark">{kicker}</span>
		<h2>{title}</h2>
		<div class="fg-grid">
			{items.map((item) => (
				<div class="fg-card reveal">
					<div class="fg-icon">{item.icon}</div>
					<h3>{item.title}</h3>
					<p>{item.desc}</p>
				</div>
			))}
		</div>
	</div>
</section>

<style>
.fg-gray{background:var(--gray-bg)}
.fg-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-top:56px}
.fg-card{background:var(--white);border:1px solid var(--gray-line);border-radius:var(--radius);padding:30px 26px;transition:all .22s ease}
.fg-card:hover{transform:translateY(-6px);box-shadow:0 22px 54px rgba(1,30,65,.12);border-color:transparent}
.fg-icon{width:46px;height:46px;border-radius:12px;background:rgba(0,194,255,.1);color:#0084b8;display:flex;align-items:center;justify-content:center;font-size:21px;margin-bottom:18px;font-weight:700}
.fg-card h3{font-size:17.5px;font-weight:800;margin-bottom:9px}
.fg-card p{font-size:14px;color:var(--gray-text)}

@media (max-width:900px){
  .fg-grid{grid-template-columns:repeat(2,1fr)}
}
@media (max-width:600px){
  .fg-grid{grid-template-columns:1fr}
}
</style>
