---
interface Cta {
	text: string;
	href: string;
}

interface Props {
	theme: "light" | "dark";
	badge: string;
	title: string;
	description: string;
	ctaPrimary: Cta;
	ctaSecondary: Cta;
}

const { theme, badge, title, description, ctaPrimary, ctaSecondary } = Astro.props;
---

<section class:list={["hero", theme]}>
	<div class="wrap hero-inner">
		<div>
			<span class="hero-badge">{badge}</span>
			<h1 set:html={title} />
			<p class="lead">{description}</p>
			<div class="cta-row">
				<a href={ctaPrimary.href} class="btn btn-accent">{ctaPrimary.text}</a>
				<a href={ctaSecondary.href} class:list={["btn", theme === "dark" ? "btn-outline" : "ph-btn-outline"]}>{ctaSecondary.text}</a>
			</div>
		</div>
		<div class="hero-visual">
			<slot />
		</div>
	</div>
</section>

<style>
.hero{position:relative;overflow:hidden}
.hero.dark{background:var(--navy);color:var(--white)}
.hero.dark::before{content:"";position:absolute;top:-200px;right:-200px;width:640px;height:640px;border-radius:50%;background:radial-gradient(circle,rgba(0,194,255,.16),transparent 65%);pointer-events:none}
.hero.dark::after{content:"";position:absolute;bottom:-260px;left:-160px;width:560px;height:560px;border-radius:50%;background:radial-gradient(circle,rgba(56,224,176,.10),transparent 65%);pointer-events:none}

.hero.light{background:var(--white);color:var(--navy)}
.hero.light::before{content:"";position:absolute;top:-160px;right:-160px;width:520px;height:520px;border-radius:50%;background:radial-gradient(circle,rgba(0,194,255,.08),transparent 65%);pointer-events:none}

.hero-inner{display:grid;grid-template-columns:1.05fr .95fr;gap:64px;align-items:center;padding:104px 0 90px;position:relative;z-index:1}

.hero-badge{display:inline-flex;align-items:center;gap:8px;font-size:13px;font-weight:700;padding:7px 16px;border-radius:999px;margin-bottom:26px}
.hero.dark .hero-badge{background:rgba(0,194,255,.12);border:1px solid rgba(0,194,255,.3);color:var(--accent)}
.hero.light .hero-badge{background:rgba(0,194,255,.08);border:1px solid rgba(0,132,184,.25);color:#0084b8}

.hero h1{font-size:clamp(40px,4.6vw,64px);font-weight:900;margin-bottom:22px}
.hero.dark h1{color:var(--white)}
.hero.light h1{color:var(--navy)}
.hero h1 :global(em){font-style:normal;color:var(--accent)}
.hero.light h1 :global(em){color:#0084b8}

.hero .lead{font-size:18px;max-width:540px;margin-bottom:34px}
.hero.dark .lead{color:var(--dark-text)}
.hero.light .lead{color:var(--gray-text)}

.cta-row{display:flex;gap:14px;flex-wrap:wrap}
.ph-btn-outline{background:transparent;color:var(--navy);border:1.5px solid var(--gray-line)}
.ph-btn-outline:hover{border-color:var(--navy)}

@media (max-width:900px){
  .hero-inner{grid-template-columns:1fr;gap:48px}
}
</style>
