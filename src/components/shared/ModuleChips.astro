---
interface Category {
	name: string;
	apps: string[];
}

interface Props {
	kicker: string;
	title: string;
	categories: Category[];
	note?: string;
}

const { kicker, title, categories, note } = Astro.props;
---

<section class="section">
	<div class="wrap">
		<span class="kicker dark">{kicker}</span>
		<h2>{title}</h2>
		<div class="mc-grid">
			{categories.map((cat) => (
				<div class="mc-cat reveal">
					<h3>{cat.name}</h3>
					<div class="mc-chips">
						{cat.apps.map((app) => <span class="mc-chip">{app}</span>)}
					</div>
				</div>
			))}
		</div>
		{note && <p class="mc-note">{note}</p>}
	</div>
</section>

<style>
.mc-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:22px;margin-top:56px}
.mc-cat{background:var(--white);border:1px solid var(--gray-line);border-radius:var(--radius);padding:26px}
.mc-cat h3{font-size:16px;font-weight:800;margin-bottom:16px}
.mc-chips{display:flex;flex-wrap:wrap;gap:8px}
.mc-chip{display:inline-block;background:var(--gray-bg);border:1px solid var(--gray-line);border-radius:999px;padding:6px 14px;font-weight:600;color:var(--navy);font-size:13px}
.mc-note{margin-top:38px;text-align:center;font-size:14px;color:var(--gray-text)}
</style>
