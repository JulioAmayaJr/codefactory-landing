---
const heroStats = [
	{ value: "+10", label: "Años de experiencia" },
	{ value: "+20", label: "Proyectos en producción" },
	{ value: "100%", label: "DTE con normativa vigente" },
];

const fcList = [
	"Factura y Crédito Fiscal",
	"DTE desde el punto de venta",
	"Notas de crédito y anulaciones",
];
---

<section class="hero">
	<div class="wrap hero-inner">
		<div>
			<span class="hero-badge">Especialistas en Odoo · El Salvador</span>
			<h1>Tecnología empresarial para digitalizar, operar y escalar tu negocio.</h1>
			<p class="lead">Implementamos Odoo ERP, desarrollamos software a la medida y automatizamos tu facturación electrónica DTE ante el Ministerio de Hacienda.</p>
			<a href="#contacto" class="btn btn-accent">Agenda una cita</a>
			<div class="hero-stats">
				{heroStats.map((stat) => (
					<div class="hstat"><b>{stat.value}</b><span>{stat.label}</span></div>
				))}
			</div>
		</div>
		<div class="feature-card reveal">
			<span class="tag">Producto destacado</span>
			<h3>Facturación Electrónica DTE</h3>
			<p>Emisión, firma y transmisión automática al Ministerio de Hacienda, integrada a tu sistema o punto de venta.</p>
			<div class="fc-label">Disponible ya</div>
			<ul class="fc-list">
				{fcList.map((item) => (
					<li>{item} <span class="pill live">Disponible</span></li>
				))}
			</ul>
			<a href="#dte" class="btn btn-accent">Conocer el facturador</a>
			<div class="fc-foot"><span>Integración nativa</span><span>·</span><span>Sello en segundos</span><span>·</span><span>Soporte local</span></div>
		</div>
	</div>
</section>

<style>
.hero{background:var(--navy);color:var(--white);position:relative;overflow:hidden}
.hero::before{content:"";position:absolute;top:-200px;right:-200px;width:640px;height:640px;border-radius:50%;background:radial-gradient(circle,rgba(0,194,255,.16),transparent 65%);pointer-events:none}
.hero::after{content:"";position:absolute;bottom:-260px;left:-160px;width:560px;height:560px;border-radius:50%;background:radial-gradient(circle,rgba(56,224,176,.10),transparent 65%);pointer-events:none}
.hero-inner{display:grid;grid-template-columns:1.08fr .92fr;gap:64px;align-items:center;padding:104px 0 90px;position:relative;z-index:1}
.hero-badge{display:inline-flex;align-items:center;gap:8px;background:rgba(0,194,255,.12);border:1px solid rgba(0,194,255,.3);color:var(--accent);font-size:13px;font-weight:700;padding:7px 16px;border-radius:999px;margin-bottom:26px}
.hero h1{font-size:clamp(34px,4.6vw,56px);font-weight:900;margin-bottom:22px}
.hero .lead{font-size:18px;color:var(--dark-text);max-width:540px;margin-bottom:34px}
.hero-stats{display:flex;gap:44px;margin-top:52px;flex-wrap:wrap}
.hstat b{display:block;font-size:34px;font-weight:900;color:var(--white)}
.hstat span{font-size:13.5px;color:var(--dark-text);font-weight:500}

.feature-card{background:linear-gradient(160deg,var(--navy-2),var(--navy-3));border:1px solid var(--dark-line);border-radius:var(--radius);padding:34px;box-shadow:0 34px 90px rgba(0,0,0,.45);position:relative}
.feature-card .tag{display:inline-block;background:var(--accent);color:var(--navy);font-size:11.5px;font-weight:800;letter-spacing:.08em;text-transform:uppercase;padding:5px 12px;border-radius:6px;margin-bottom:18px}
.feature-card h3{font-size:24px;font-weight:800;margin-bottom:10px}
.feature-card>p{font-size:14.5px;color:var(--dark-text);margin-bottom:22px}
.fc-label{font-size:12px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:#7e94b3;margin-bottom:12px}
.fc-list{list-style:none;display:grid;gap:10px;margin-bottom:22px}
.fc-list li{display:flex;align-items:center;justify-content:space-between;background:rgba(255,255,255,.05);border:1px solid var(--dark-line);border-radius:10px;padding:12px 16px;font-size:14px;font-weight:600}
.pill{font-size:11px;font-weight:800;padding:4px 11px;border-radius:999px;letter-spacing:.05em;text-transform:uppercase}
.pill.live{background:rgba(56,224,176,.15);color:var(--accent-2);border:1px solid rgba(56,224,176,.35)}
.feature-card .btn{width:100%;justify-content:center}
.fc-foot{display:flex;gap:14px;justify-content:center;margin-top:16px;font-size:12px;color:#7e94b3;font-weight:600}

@media (max-width:900px){
  .hero-inner{grid-template-columns:1fr;gap:48px}
}
@media (max-width:600px){
  .hero-stats{gap:28px}
}
</style>
